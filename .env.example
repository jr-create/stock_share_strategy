# Stock Replay 配置文件
# 复制此文件为 .env 并根据需要修改

# =============================================================================
# 数据库配置
# =============================================================================

# 本地 PostgreSQL (默认)
# 如果你有本地安装的 PostgreSQL，使用此配置
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stock_replay

# Docker PostgreSQL (可选)
# 如果使用 docker-compose 启动数据库，取消注释下面这行并注释上面的配置
# DATABASE_URL=postgres://stock_replay:stock_replay_dev@localhost:5432/stock_replay

# =============================================================================
# 服务器配置
# =============================================================================
RUST_LOG=info,stock_replay_web=debug,tower_http=debug
SERVER_ADDR=127.0.0.1:3000
